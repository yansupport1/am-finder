{
  "version": 2,
  "functions": {
    "api/search.py": {
      "maxDuration": 60
    },
    "api/find.py": {
      "maxDuration": 30
    },
    "api/video.py": {
      "maxDuration": 30
    },
    "api/time.py": {
      "maxDuration": 10
    },
    "api/version.py": {
      "maxDuration": 10
    }
  },
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "fonts/**",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    },
    {
      "src": "video/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(|index\\.html|css/yanz-anim\\.css|js/yanz-anim\\.js)",
      "headers": {
        "cache-control": "no-cache, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/api/find",
      "dest": "/api/find.py"
    },
    {
      "src": "/api/track",
      "dest": "/api/track.py"
    },
    {
      "src": "/api/video",
      "dest": "/api/video.py"
    },
    {
      "src": "/api/search",
      "dest": "/api/search.py"
    },
    {
      "src": "/api/time",
      "dest": "/api/time.py"
    },
    {
      "src": "/api/version",
      "dest": "/api/version.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
